{
	"name": "@wavv/sdk",
	"version": "0.0.2",
	"description": "Embed WAVV's dialer, messenger and callboards in your product",
	"keywords": [
		"wavv",
		"dialer",
		"messenger",
		"sms",
		"power dialer",
		"callboards",
		"embed",
		"sdk"
	],
	"homepage": "https://sdk.wavv.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wavvcomm/sdk.git"
	},
	"author": "WAVV Communications",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"sideEffects": false,
	"files": [
		"dist/*.js",
		"dist/*.d.ts"
	],
	"scripts": {
		"build": "node scripts/release.mjs build",
		"check:actions": "node scripts/check-actions.mjs",
		"verify": "node scripts/release.mjs verify",
		"release": "node scripts/release.mjs publish",
		"release:dry": "node scripts/release.mjs publish --dry-run",
		"prepublishOnly": "node scripts/release.mjs verify",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "biome lint",
		"fix": "biome lint --fix",
		"fix:unsafe": "pnpm run fix --unsafe",
		"check": "biome check --write"
	},
	"devDependencies": {
		"typescript": "^7"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}
