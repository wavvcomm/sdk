{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"module": "ES2022",
		"target": "ES2020",
		"moduleResolution": "bundler",
		"rootDir": "src",
		"outDir": "dist",
		"declaration": true,
		"declarationMap": false,
		"sourceMap": false
	},
	"include": ["src"],
	"exclude": ["src/**/*.test.ts"]
}
